# Get a free API key at https://finnhub.io/dashboard
VITE_FINNHUB_KEY=your_finnhub_key_here

# Optional CORS proxy prefix used to fetch chart history from Yahoo Finance.
# Default (when unset) is https://api.allorigins.win/raw?url= — a free public
# proxy. For better reliability, deploy your own Cloudflare Worker (free tier,
# 100k req/day) and point this at it. Format: a URL prefix that the encoded
# target URL is appended to. See docs/CORS-WORKER.md.
# VITE_CORS_PROXY=https://your-worker.example.workers.dev/?url=
